# Copy to .env and fill in. .env is git-ignored and must stay that way.
# Every value here has a safe default EXCEPT SECRET_KEY, which is required.

# ——— required ———

# JWT signing key. No default on purpose: a fallback like "changeme" would work
# silently in development and ship forgeable tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ——— storage ———

# DATABASE_URL=sqlite:///./data/scholar.db
#
# Where libraries (FAISS + lexical indexes, uploaded files) live. Empty means
# the repo-local data/workspaces, which is correct for development and WRONG for
# any deployment: it sits inside the source tree, so a redeploy that replaces
# the source destroys every user's library. Point this at a mounted volume.
# DATA_ROOT=

# ——— web ———

# The browser origin allowed to call this API (CORS).
# FRONTEND_ORIGIN=http://localhost:5173

# Where links in outbound email point. Defaults to FRONTEND_ORIGIN, which is
# right in development and wrong behind a proxy or a custom domain — the origin
# allowed to call the API and the address a human clicks are not always the same.
# PUBLIC_APP_URL=https://scholar.example.com

# Set BOTH once served over HTTPS. Over plain http://localhost, SameSite=Lax
# works without Secure; in production, neither is optional.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# ——— sessions ———

# Access tokens are short by design; the refresh token is what stops that from
# meaning "logged out every 30 minutes". Refresh tokens rotate on every use and
# are revocable server-side, so a stolen one can be detected and cancelled.
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=30
# RESET_TOKEN_EXPIRE_MINUTES=30
# INVITATION_EXPIRE_DAYS=14

# Per-user budgets. /ask runs retrieval, reranking and a generation, so it is
# the expensive route — and a billing control the moment generation is paid.
# ASK_RATE_LIMIT_PER_HOUR=120
# UPLOAD_RATE_LIMIT_PER_HOUR=60

# ——— indexing queue ———
#
# Empty means NO queue: uploads are indexed inside the request, which races the
# proxy timeout on a large document. Fine locally, wrong in production.
#
# Setting this is only half the job — the worker is a SECOND process:
#     arq backend.jobs.WorkerSettings
# A deploy that starts only the API will accept uploads and index none of them.
# Whichever path ran is recorded on the IndexJob row, so the difference is
# visible rather than mysterious.
#
# REDIS_URL=redis://localhost:6379

# ——— email ———
#
# With SMTP_HOST empty the app still runs, but password-reset and invitation
# tokens are written to the LOG instead of being sent. That is fine on a laptop
# and an account-takeover vector on a server: anyone who can read the logs can
# take over any account. Configure this before serving real users.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Scholar <no-reply@example.com>
#
# STARTTLS on 587 (default) vs implicit TLS on 465. Turn STARTTLS off ONLY for a
# relay on localhost — over the internet it sends SMTP_PASSWORD in clear text.
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_TIMEOUT=10

# ——— retrieval / models ———

# Query expansion: none | prf | hyde. "hyde" is the measured default; "prf" was
# built, measured and rejected (see docs/04-pmf-roadmap.md).
# QUERY_EXPANSION=hyde

# OCR for scanned PDFs. Needs the Tesseract binary; with none installed the
# indexing job fails with a message naming the server's missing capability,
# rather than blaming the file or crashing.
# OCR_ENABLED=true
# TESSDATA_PREFIX=

# ——— which model writes the answers ———

# "ollama" (default) runs gemma3:4b on this machine: free, private, and right
# for development — but undeployable, since a hosted box has no Ollama.
# "hosted" points at any OpenAI-compatible endpoint so Scholar can run in a
# container. Retrieval, reranking, citations and the grounding contract are
# identical either way; only the model changes.
# LLM_PROVIDER=ollama

# Required when LLM_PROVIDER=hosted — all three, or startup fails loudly rather
# than the first question failing. Free-tier options, all speaking the same
# protocol (so switching vendor is these two lines, not a code change):
#
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#               LLM_MODEL=llama-3.3-70b-versatile   (verified working)
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#               LLM_MODEL=gemini-2.0-flash
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#               LLM_MODEL=<any model id ending in :free>
#
# Model ids change as vendors add and retire models — check the provider's
# current list. A wrong id gives a clear "does not serve a model named ..."
# error rather than a silent fallback.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Ceiling on one generated answer, and the per-question spend cap on a paid
# provider. Grounded answers are short by design, so this is a runaway guard.
# LLM_MAX_TOKENS=2048

# How long to wait on the model before giving up (seconds). Without a bound, a
# hung model pins a worker forever and the app dies quietly.
# LLM_TIMEOUT_SECONDS=180

# Which commit /healthz reports, so a deploy can be confirmed with one request
# instead of a trip to the hosting dashboard. Truncated to 7 characters.
#
# Leave this unset on Railway: the app falls back to RAILWAY_GIT_COMMIT_SHA,
# which the platform injects at runtime for free. Elsewhere it is set at build
# time — `docker build --build-arg GIT_SHA=$(git rev-parse --short HEAD)`.
# Unset everywhere, /healthz reports "unknown" rather than an empty field.
# BUILD_SHA=

# Diversity-aware selection of the final k passages (Maximal Marginal
# Relevance). MEASURED AND REJECTED — it does reduce redundancy, monotonically,
# but costs accuracy at every setting tried (hit@5 94.1% -> 92.2% at the mildest
# lambda). Left selectable so the comparison stays reproducible; see backend/mmr.py.
# Lambda 1.0 is pure relevance, 0.0 is pure diversity.
# MMR_ENABLED=false
# MMR_LAMBDA=0.7
