# Python
.venv/
__pycache__/
*.pyc

# Data (FAISS indexes, per-user stores, SQLite DB) — never commit
data/

# Eval corpus PDFs: sample_agreement.pdf is generated from the committed .txt
# (python -m backend.eval --build-corpus) and rag_paper.pdf is downloaded.
# Neither belongs in git — see backend/eval/corpus/README.md.
backend/eval/corpus/*.pdf

# Secrets — never commit
.env

# Node / frontend
node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Local tooling config (kept on disk, not published)
claude.md
.claude/

# Stray local files
*.pptx
backend/api.py.tmp.*

# OS / editor
.DS_Store
Thumbs.db

# Backup archives. These contain the REAL database and uploaded documents —
# account emails, password hashes, and people's files. `backend.backup create`
# writes here by default, so an un-ignored backups/ is one `git add -A` away
# from publishing a customer's contracts to a public repo.
backups/
*.tar.gz

# Personal notes, not project documentation. INTERVIEW-PREP.md is a private
# study guide — it exists on disk and should stay there, but it is not part of
# what this repository publishes.
docs/INTERVIEW-PREP.md
