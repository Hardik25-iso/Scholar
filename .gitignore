# Python
.venv/
__pycache__/
*.pyc

# Data (FAISS indexes, per-user stores, SQLite DB) — never commit
data/

# Eval corpus PDFs: sample_agreement.pdf is generated from the committed .txt
# (python -m backend.eval --build-corpus) and rag_paper.pdf is downloaded.
# Neither belongs in git — see backend/eval/corpus/README.md.
backend/eval/corpus/*.pdf

# Secrets — never commit
.env

# Node / frontend
node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Local tooling config (kept on disk, not published)
claude.md
.claude/

# Stray local files
*.pptx
backend/api.py.tmp.*

# OS / editor
.DS_Store
Thumbs.db
